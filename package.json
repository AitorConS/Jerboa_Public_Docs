{
  "name": "jerboa-public-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/sync-docs.mjs --if-present && astro dev",
    "build": "node scripts/sync-docs.mjs --if-present && astro build",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check",
    "docs:anchors": "node scripts/check-anchors.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint:design": "node scripts/lint-design.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13"
  }
}
