{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/getting-started/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/getting-started/",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/getting-started/",
      "permanent": true
    },
    {
      "source": "/docs/",
      "destination": "/getting-started/",
      "permanent": true
    },
    {
      "source": "/docs/index.html",
      "destination": "/getting-started/",
      "permanent": true
    },
    {
      "source": "/macos-firecracker",
      "destination": "/macos-spark/",
      "permanent": true
    },
    {
      "source": "/macos-firecracker/",
      "destination": "/macos-spark/",
      "permanent": true
    },
    {
      "source": "/macos-firecracker.html",
      "destination": "/macos-spark/",
      "permanent": true
    },
    {
      "source": "/docs/macos-firecracker",
      "destination": "/macos-spark/",
      "permanent": true
    },
    {
      "source": "/docs/macos-firecracker/",
      "destination": "/macos-spark/",
      "permanent": true
    },
    {
      "source": "/docs/macos-firecracker.html",
      "destination": "/macos-spark/",
      "permanent": true
    },
    {
      "source": "/:slug(macos-distribution|registry-protocol|getting-started|macos-snapshots|package-recipes|release-process|troubleshooting|build-concepts|macos-shutdown|packages-arm64|postgres-arm64|cli-reference|observability|architecture|macos-guide|macos-spark|macos-stats|benchmarks|changelog|registry|compose|macos)",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(macos-distribution|registry-protocol|getting-started|macos-snapshots|package-recipes|release-process|troubleshooting|build-concepts|macos-shutdown|packages-arm64|postgres-arm64|cli-reference|observability|architecture|macos-guide|macos-spark|macos-stats|benchmarks|changelog|registry|compose|macos).html",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/docs/:slug(macos-distribution|registry-protocol|getting-started|macos-snapshots|package-recipes|release-process|troubleshooting|build-concepts|macos-shutdown|packages-arm64|postgres-arm64|cli-reference|observability|architecture|macos-guide|macos-spark|macos-stats|benchmarks|changelog|registry|compose|macos)",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/docs/:slug(macos-distribution|registry-protocol|getting-started|macos-snapshots|package-recipes|release-process|troubleshooting|build-concepts|macos-shutdown|packages-arm64|postgres-arm64|cli-reference|observability|architecture|macos-guide|macos-spark|macos-stats|benchmarks|changelog|registry|compose|macos)/",
      "destination": "/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Supports-Loading-Mode",
          "value": "credentialed-prerender"
        }
      ]
    }
  ]
}
