{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "https://docs.jerboa.dev/docs/",
      "permanent": true
    },
    {
      "source": "/:page.html",
      "destination": "https://docs.jerboa.dev/docs/:page/",
      "permanent": true
    }
  ]
}
