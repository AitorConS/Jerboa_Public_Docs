---
// Shared site header — identical on every page so it doesn't shift on nav.
// `active` only highlights the current section.
export interface Props { active?: 'home' | 'docs' | 'releases'; }
const { active = 'home' } = Astro.props;
---
<header class="site-header" transition:name="site-header">
  <nav class="site-nav wrap">
    <a href="https://jerboa.dev/" class="brand jb-link">
      <img class="brand-mark" src="/jerboa.webp" alt="" width="42" height="42" />
      <span class="brand-name">jerboa</span>
    </a>

    <!-- CSS-only mobile menu toggle (no JS, survives view transitions). -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <div class="nav-menu">
      <div class="nav-links">
        <a class="jb-link" href="https://jerboa.dev/#features">Features</a>
        <a class="jb-link" href="https://jerboa.dev/#why">Why unikernels</a>
        <a class={`jb-link ${active === 'docs' ? 'is-active' : ''}`} href="/">Documentation</a>
        <a class="jb-link" href="https://jerboa.dev/releases/">Releases</a>
      </div>
      <a class="jb-btn nav-gh" href="https://github.com/AitorConS/jerboa" style="display:inline-flex;align-items:center;gap:8px;font-size:14px;padding:8px 15px;border-radius:8px;border:1px solid var(--border);color:var(--ink);font-weight:500">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.53.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58C20.57 22.29 24 17.8 24 12.5 24 5.87 18.63.5 12 .5z"/></svg>
        <span>GitHub</span>
      </a>
      <a class="jb-btn nav-cta" href="/getting-started/" style="font-size:14px;padding:8px 16px;border-radius:8px;background:var(--ink);color:var(--sand);font-weight:500">Get started</a>
    </div>
  </nav>
</header>
