---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import docs from '../data/docs.json';
import type { MarkdownLayoutProps } from 'astro';
type Props = MarkdownLayoutProps<{ title: string; source: string }>;
const { frontmatter } = Astro.props;
const markdown = import.meta.glob('../pages/*.md', { eager: true });
const groups = [
  { title: 'Start', slugs: ['getting-started', 'build-concepts'] },
  { title: 'Guides', slugs: ['compose', 'observability', 'troubleshooting'] },
  { title: 'Reference', slugs: ['cli-reference', 'architecture'] },
].map(group => ({ ...group, pages: group.slugs.map(slug => {
  const page = docs.pages.find(page => page.slug === slug)!;
  const module = markdown[`../pages/${slug}.md`] as { getHeadings: () => { depth: number; slug: string; text: string }[] };
  return { ...page, headings: module.getHeadings().filter(heading => heading.depth === 2) };
}) }));
---
<Base title={`jerboa — ${frontmatter.title}`}>
  <Nav active="docs" />
  <div class="wrap docs-grid">
    <aside aria-label="Documentation navigation">
      <p class="eyebrow">Documentation · v{docs.versions.cli}</p>
      <nav class="doc-tree" aria-label="Guides">
        {groups.map(group => <details class="tree-group" open data-group={group.title}>
          <summary>{group.title}</summary>
          <div class="tree-children">
            {group.pages.map(page => {
              const isCurrent = frontmatter.source === `${page.slug}.md`;
              return (
              <div class="tree-page">
                <div class="tree-row">
                  <a href={page.url} aria-current={isCurrent ? 'page' : undefined}>{page.title}</a>
                  {page.headings.length > 0 && <button type="button" class="tree-caret" data-caret={page.slug} aria-expanded={isCurrent ? 'true' : 'false'} aria-label={`Toggle sections for ${page.title}`}></button>}
                </div>
                {page.headings.length > 0 && (
                <div class="tree-children tree-sections" data-sections={page.slug} hidden={!isCurrent}>
                  {page.headings.map(heading => <a href={`${page.url}#${heading.slug}`}>{heading.text}</a>)}
                </div>
                )}
              </div>
              );
            })}
          </div>
        </details>)}
      </nav>
    </aside>
    <main class="doc-main">
      <slot />
    </main>
  </div>
  <Footer />
<script>
  // Section toggles: expand/collapse a page's headings without navigating.
  // State is kept in a session store so ClientRouter page changes stop
  // resetting the sidebar. Stored state wins; keys missing from the store
  // are seeded from the server render (current page expanded, rest collapsed).
  const sectionStore = ((window as any).__docsSections ??= {});
  const syncSections = () => {
    document.querySelectorAll('[data-caret]').forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      const slug = btn.getAttribute('data-caret') ?? '';
      const panel = document.querySelector(`[data-sections="${slug}"]`);
      if (!(panel instanceof HTMLElement)) return;
      if (slug in sectionStore) {
        const expanded = sectionStore[slug];
        btn.setAttribute('aria-expanded', String(expanded));
        if (expanded) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      } else {
        sectionStore[slug] = btn.getAttribute('aria-expanded') === 'true';
      }
      if (!btn.hasAttribute('data-bound')) {
        btn.setAttribute('data-bound', '');
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          sectionStore[slug] = !expanded;
          if (expanded) panel.setAttribute('hidden', '');
          else panel.removeAttribute('hidden');
        });
      }
    });
  };
  // Category toggles are independent (no shared `name`), and their open
  // state survives ClientRouter navigations via this session store. Without
  // it the server would re-render every group as open on each page change.
  const groupStore = ((window as any).__docsGroups ??= {});
  const syncGroups = () => {
    document.querySelectorAll('details.tree-group').forEach((d) => {
      if (!(d instanceof HTMLDetailsElement)) return;
      const key = d.getAttribute('data-group') ?? '';
      if (key in groupStore) d.open = groupStore[key];
      if (!d.hasAttribute('data-group-bound')) {
        d.setAttribute('data-group-bound', '');
        d.addEventListener('toggle', () => { groupStore[key] = d.open; });
      }
    });
  };
  syncSections();
  syncGroups();
  document.addEventListener('astro:page-load', () => { syncSections(); syncGroups(); });
</script>
</Base>
<style>
  /* Docs override the global no-smooth-scroll rule: article changes and
     in-page anchors scroll smoothly instead of jumping to the top. */
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
  .docs-grid { display: grid; grid-template-columns: 240px minmax(0, 1fr); align-items: start; gap: 56px; padding-top: 40px; padding-bottom: 80px; }
  aside { position: sticky; top: 88px; max-height: calc(100dvh / 1.25 - 110px); overflow-y: auto; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--muted) 34%, transparent) transparent; }
  aside::-webkit-scrollbar { width: 9px; }
  aside::-webkit-scrollbar-track { background: transparent; }
  aside::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--muted) 34%, transparent); border-radius: 9px; border: 2px solid transparent; background-clip: padding-box; }
  aside:hover::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--accent) 55%, transparent); background-clip: padding-box; }
  aside::-webkit-scrollbar-thumb:hover { background: var(--accent); background-clip: padding-box; }
  .eyebrow { font-family: 'Geist Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin-bottom: 12px; }
  .doc-tree { font-size: 14px; }
  .doc-tree summary { display: flex; align-items: baseline; gap: 10px; list-style: none; cursor: pointer; padding: 5px 0; }
  .doc-tree summary::-webkit-details-marker { display: none; }
  .doc-tree summary::before { content: ''; flex: 0 0 5px; width: 5px; height: 5px; border-right: 1px solid var(--muted); border-bottom: 1px solid var(--muted); transform: rotate(-45deg); position: relative; top: -2px; }
  .doc-tree details[open] > summary::before { transform: rotate(45deg); }
  .tree-group { margin-bottom: 12px; }
  .tree-group > summary { font-weight: 600; }
  .tree-children { border-left: 1px solid var(--border); margin: 4px 0 4px 2px; padding-left: 17px; }
  .doc-tree a { display: block; color: var(--ink); padding: 3px 7px; border-radius: 4px; line-height: 1.45; }
  .tree-row { display: flex; align-items: baseline; gap: 10px; padding: 1px 0; }
  .tree-row a { flex: 1; min-width: 0; }
  .tree-caret { flex: 0 0 auto; width: 20px; height: 20px; background: none; border: none; cursor: pointer; padding: 0; position: relative; top: 3px; }
  .tree-caret::before { content: ''; display: block; width: 5px; height: 5px; margin: 0 auto; border-right: 1px solid var(--muted); border-bottom: 1px solid var(--muted); transform: rotate(-45deg); transition: transform .2s ease; }
  .tree-caret[aria-expanded='true']::before { transform: rotate(45deg); }
  .tree-sections { margin-left: 2px; }
  .tree-sections a { color: var(--muted); font-size: 13px; margin: 3px 0; }
  /* Smooth expand/collapse for categories and sections (same feel as the
     smooth scrolling). Grid-rows trick; instant fallback with reduced
     motion or where ::details-content is unsupported. */
  @media (prefers-reduced-motion: no-preference) {
    .doc-tree summary::before { transition: transform .2s ease; }
    .tree-sections {
      display: grid;
      grid-template-rows: 1fr;
      opacity: 1;
      transition: grid-template-rows .25s ease, opacity .2s ease, margin-top .25s ease, margin-bottom .25s ease, visibility 0s;
    }
    .tree-sections[hidden] {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      visibility: hidden;
      margin-top: 0;
      margin-bottom: 0;
      transition: grid-template-rows .25s ease, opacity .2s ease, margin-top .25s ease, margin-bottom .25s ease, visibility 0s .25s;
    }
    .tree-sections > * { min-height: 0; overflow: hidden; }
    @supports selector(details::details-content) {
      details.tree-group::details-content { content-visibility: visible; }
      .tree-group > .tree-children {
        display: grid;
        grid-template-rows: 1fr;
        opacity: 1;
        transition: grid-template-rows .25s ease, opacity .2s ease, margin-top .25s ease, margin-bottom .25s ease, visibility 0s;
      }
      .tree-group:not([open]) > .tree-children {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        visibility: hidden;
        margin-top: 0;
        margin-bottom: 0;
        transition: grid-template-rows .25s ease, opacity .2s ease, margin-top .25s ease, margin-bottom .25s ease, visibility 0s .25s;
      }
      .tree-group > .tree-children > * { min-height: 0; overflow: hidden; }
    }
  }
  .doc-tree a:hover, .doc-tree a[aria-current] { background: var(--surface); color: var(--ink); }
  .doc-tree a[aria-current] { font-weight: 500; }
  .doc-tree summary:focus-visible, .doc-tree a:focus-visible, .tree-caret:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .doc-main { min-width: 0; line-height: 1.75; overflow-wrap: anywhere; }
  .doc-main :global(h1) { font-family: 'Newsreader', serif; font-size: clamp(36px, 5vw, 56px); line-height: 1.15; font-weight: 300; margin-bottom: 24px; }
  .doc-main :global(h2) { margin: 36px 0 16px; font-size: 26px; }
  .doc-main :global(h3) { margin: 26px 0 12px; font-size: 19px; }
  .doc-main :global(h2, h3, h4) { scroll-margin-top: 100px; }
  .doc-main :global(p, ul, ol, pre, table, blockquote) { margin-bottom: 18px; }
  .doc-main :global(ul, ol) { padding-left: 24px; }
  .doc-main :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .doc-main :global(code) { font-family: 'Geist Mono', monospace; font-size: .85em; }
  .doc-main :global(:not(pre) > code) { background: var(--surface); padding: 2px 5px; border-radius: 4px; }
  .doc-main :global(pre) { padding: 20px; border-radius: 10px; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.65; }
  .doc-main :global(table) { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 14px; }
  .doc-main :global(th, td) { border: 1px solid var(--border); padding: 10px 14px; text-align: left; }
  .doc-main :global(th) { background: var(--surface); }
  .doc-main :global(blockquote) { border-left: 3px solid var(--accent); padding-left: 18px; color: var(--muted); }
  .doc-main :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 28px 0; }
  @media (max-width: 800px) {
    .docs-grid { grid-template-columns: 1fr; gap: 28px; }
    aside { position: static; max-height: none; }
  }
</style>
