---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import docs from '../data/docs.json';
import type { MarkdownLayoutProps } from 'astro';
type Props = MarkdownLayoutProps<{ title: string; source: string }>;
const { frontmatter } = Astro.props;
const markdown = import.meta.glob('../pages/*.md', { eager: true });
const groups = [
  { title: 'Start', slugs: ['getting-started', 'build-concepts'] },
  { title: 'Guides', slugs: ['macos-guide', 'compose', 'observability', 'troubleshooting'] },
  { title: 'Reference', slugs: ['cli-reference', 'architecture'] },
  { title: 'macOS (advanced)', slugs: ['macos', 'macos-firecracker', 'packages-arm64', 'postgres-arm64', 'macos-snapshots', 'macos-shutdown', 'macos-stats', 'macos-distribution'] },
].map(group => ({ ...group, pages: group.slugs.map(slug => {
  const page = docs.pages.find(page => page.slug === slug)!;
  const module = markdown[`../pages/${slug}.md`] as { getHeadings: () => { depth: number; slug: string; text: string }[] };
  return { ...page, headings: module.getHeadings().filter(heading => heading.depth === 2) };
}) }));
const current = groups.flatMap(group => group.pages).find(page => `${page.slug}.md` === frontmatter.source);
---
<Base title={`jerboa — ${frontmatter.title}`}>
  <Nav active="docs" />
  <div class="wrap docs-grid">
    <aside aria-label="Documentation navigation">
      <p class="eyebrow">Documentation · <span translate="no">v{docs.versions.cli}</span></p>
      <nav class="doc-tree" aria-label="Guides">
        {groups.map(group => {
          const hasCurrent = group.pages.some(page => `${page.slug}.md` === frontmatter.source);
          return (
          <details class="tree-group" open={hasCurrent} data-group={group.title}>
            <summary>{group.title}</summary>
            <div class="tree-children">
              <div class="tree-links">
                {group.pages.map(page => {
                  const isCurrent = `${page.slug}.md` === frontmatter.source;
                  return <a href={page.url} aria-current={isCurrent ? 'page' : undefined}>{page.title}</a>;
                })}
              </div>
            </div>
          </details>
          );
        })}
      </nav>
    </aside>
    <main class="doc-main" id="main">
      <slot />
    </main>
    {current && current.headings.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <p class="eyebrow">On this page</p>
      <ul>
        {current.headings.map(heading => <li><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}
      </ul>
    </nav>
    )}
  </div>
  <Footer />
<script>
  // Category toggles are independent (no shared `name`), and their open
  // state survives ClientRouter navigations via this session store. Without
  // it the server render (only the current branch open) would reset the
  // sidebar on each page change.
  const groupStore = ((window as any).__docsGroups ??= {});
  const syncGroups = () => {
    document.querySelectorAll('details.tree-group').forEach((d) => {
      if (!(d instanceof HTMLDetailsElement)) return;
      const key = d.getAttribute('data-group') ?? '';
      if (key in groupStore) d.open = groupStore[key];
      if (!d.hasAttribute('data-group-bound')) {
        d.setAttribute('data-group-bound', '');
        d.addEventListener('toggle', () => { groupStore[key] = d.open; });
      }
    });
  };
  // Scrollspy for the "On this page" column: highlight the section in view.
  const setupSpy = () => {
    ((window as any).__tocObserver)?.disconnect();
    const links = Array.from(document.querySelectorAll('[data-toc-link]'));
    if (!links.length) return;
    const byId = new Map(links.map((l) => [(l as HTMLAnchorElement).getAttribute('href')?.slice(1), l]));
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((l) => l.removeAttribute('aria-current'));
        byId.get((entry.target as HTMLElement).id)?.setAttribute('aria-current', 'true');
      }
    }, { rootMargin: '-12% 0% -70% 0%' });
    document.querySelectorAll('.doc-main h2[id]').forEach((h) => observer.observe(h));
    (window as any).__tocObserver = observer;
  };
  syncGroups();
  setupSpy();
  document.addEventListener('astro:page-load', () => { syncGroups(); setupSpy(); });
</script>
</Base>
<style>
  /* Docs override the global no-smooth-scroll rule: in-page anchors scroll
     smoothly instead of jumping. */
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  .docs-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr) minmax(0, 1fr); gap: var(--space-48); align-items: start; padding-top: var(--space-40); padding-bottom: var(--space-80); }
  aside, .toc { position: sticky; top: calc(var(--nav-height) + var(--space-24)); max-height: calc(100dvh - var(--nav-height) - var(--space-48)); overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
  .eyebrow { font: var(--weight-medium) var(--text-12) / var(--leading-body) var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: var(--space-12); }

  /* ===== sidebar tree ===== */
  .doc-tree { font-size: var(--text-14); }
  .doc-tree summary { display: flex; align-items: center; gap: var(--space-8); min-height: var(--control-lg); list-style: none; cursor: pointer; font-weight: var(--weight-medium); color: var(--text); }
  .doc-tree summary::-webkit-details-marker { display: none; }
  .doc-tree summary::before { content: ''; width: var(--space-4); height: var(--space-4); border-right: var(--hairline) solid var(--text-muted); border-bottom: var(--hairline) solid var(--text-muted); transform: rotate(-45deg); transition: transform var(--duration-layout) var(--ease-layout); }
  .doc-tree details[open] > summary::before { transform: rotate(45deg); }
  .tree-children { border-left: var(--hairline) solid var(--border); margin-left: var(--space-4); }
  .doc-tree a { display: flex; align-items: center; min-height: var(--control-lg); margin-left: calc(-1 * var(--hairline)); padding: 0 var(--space-12); border-left: var(--hairline) solid transparent; color: var(--text-muted); transition: color var(--duration-hover) var(--ease-hover), border-color var(--duration-hover) var(--ease-hover); }
  .doc-tree a:hover { color: var(--text); }
  .doc-tree a[aria-current] { color: var(--text); border-left-color: var(--text); }

  /* ===== on this page ===== */
  .toc { font-size: var(--text-14); }
  .toc ul { list-style: none; border-left: var(--hairline) solid var(--border); }
  .toc a { display: flex; align-items: center; min-height: var(--control-lg); margin-left: calc(-1 * var(--hairline)); padding: 0 var(--space-12); border-left: var(--hairline) solid transparent; color: var(--text-muted); transition: color var(--duration-hover) var(--ease-hover), border-color var(--duration-hover) var(--ease-hover); }
  .toc a:hover { color: var(--text); }
  .toc a[aria-current='true'] { color: var(--text); border-left-color: var(--text); }

  /* ===== article ===== */
  .doc-main { min-width: 0; max-width: var(--reading); font-size: var(--text-16); line-height: var(--leading-body); overflow-wrap: anywhere; }
  .doc-main :global(h1), .doc-main :global(h2), .doc-main :global(h3) { font-family: var(--font-display); font-weight: var(--weight-display); line-height: var(--leading-display); letter-spacing: var(--tracking-display); text-wrap: balance; }
  .doc-main :global(h1) { font-size: var(--text-48); margin-bottom: var(--space-32); }
  .doc-main :global(h2) { font-size: var(--text-24); margin: var(--space-64) 0 var(--space-16); padding-top: var(--space-32); border-top: var(--hairline) solid var(--border); }
  .doc-main :global(h3) { font-size: var(--text-16); margin: var(--space-32) 0 var(--space-12); }
  /* The synced pages put a rule under the title and between sections; the
     section border replaces them. */
  .doc-main :global(h1 + hr), .doc-main :global(hr:has(+ h2)) { display: none; }
  .doc-main :global(h1 + hr + h2), .doc-main :global(h1 + h2) { margin-top: 0; padding-top: 0; border-top: 0; }
  .doc-main :global(p), .doc-main :global(ul), .doc-main :global(ol), .doc-main :global(pre), .doc-main :global(table), .doc-main :global(blockquote) { margin-bottom: var(--space-16); }
  .doc-main :global(p), .doc-main :global(li) { color: var(--stone-200); }
  .doc-main :global(ul), .doc-main :global(ol) { padding-left: var(--space-24); }
  .doc-main :global(li + li) { margin-top: var(--space-4); }
  .doc-main :global(strong) { color: var(--text); font-weight: var(--weight-display); }
  .doc-main :global(a) { color: var(--text); text-decoration: underline; text-decoration-color: var(--graphic-muted); text-underline-offset: 0.25em; transition: text-decoration-color var(--duration-hover) var(--ease-hover); }
  .doc-main :global(a:hover) { text-decoration-color: var(--text); }
  .doc-main :global(code) { font-family: var(--font-mono); font-size: var(--text-14); }
  .doc-main :global(:not(pre) > code) { padding: 0 var(--space-4); border: var(--hairline) solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text); }
  /* Shiki's css-variables theme, mapped onto the stone tokens: monochrome,
     with emphasis by lightness only. */
  :global(:root) {
    --astro-code-foreground: var(--stone-200);
    --astro-code-background: var(--surface);
    --astro-code-token-keyword: var(--text);
    --astro-code-token-function: var(--text);
    --astro-code-token-constant: var(--stone-200);
    --astro-code-token-parameter: var(--stone-200);
    --astro-code-token-string: var(--stone-400);
    --astro-code-token-string-expression: var(--stone-400);
    --astro-code-token-comment: var(--text-muted);
    --astro-code-token-punctuation: var(--text-muted);
    --astro-code-token-link: var(--text);
  }
  /* Shiki writes its own background inline; the surface token wins. */
  .doc-main :global(pre) { padding: var(--space-16); border: var(--hairline) solid var(--border); border-radius: var(--radius-lg); background: var(--surface) !important; white-space: pre-wrap; font-size: var(--text-14); line-height: var(--leading-body); }
  .doc-main :global(table) { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: var(--text-14); font-variant-numeric: tabular-nums; }
  .doc-main :global(th), .doc-main :global(td) { padding: var(--space-12) var(--space-12) var(--space-12) 0; border-bottom: var(--hairline) solid var(--border); text-align: left; vertical-align: top; }
  .doc-main :global(th) { font: var(--weight-medium) var(--text-12) / var(--leading-body) var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
  .doc-main :global(blockquote) { padding-left: var(--space-16); border-left: var(--focus-width) solid var(--border); color: var(--text-muted); }
  .doc-main :global(hr) { border: 0; border-top: var(--hairline) solid var(--border); margin: var(--space-32) 0; }

  @media (max-width: 70em) {
    .docs-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); }
    .toc { display: none; }
  }
  @media (max-width: 54em) {
    .docs-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-24); padding-top: var(--space-24); }
    aside { position: static; max-height: none; }
    .doc-main :global(h1) { font-size: var(--text-32); }
  }
</style>
