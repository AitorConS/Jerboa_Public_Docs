---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import docs from '../data/docs.json';
import type { MarkdownLayoutProps } from 'astro';
type Props = MarkdownLayoutProps<{ title: string; source: string }>;
const { frontmatter } = Astro.props;
const markdown = import.meta.glob('../pages/*.md', { eager: true });
const groups = [
  { title: 'Start', slugs: ['getting-started', 'build-concepts'] },
  { title: 'Guides', slugs: ['macos-guide', 'compose', 'observability', 'troubleshooting'] },
  { title: 'Reference', slugs: ['cli-reference', 'architecture'] },
  { title: 'macOS (advanced)', slugs: ['macos', 'macos-firecracker', 'packages-arm64', 'postgres-arm64', 'macos-snapshots', 'macos-shutdown', 'macos-stats', 'macos-distribution'] },
].map(group => ({ ...group, pages: group.slugs.map(slug => {
  const page = docs.pages.find(page => page.slug === slug)!;
  const module = markdown[`../pages/${slug}.md`] as { getHeadings: () => { depth: number; slug: string; text: string }[] };
  return { ...page, headings: module.getHeadings().filter(heading => heading.depth === 2) };
}) }));
const current = groups.flatMap(group => group.pages).find(page => `${page.slug}.md` === frontmatter.source);
---
<Base title={`jerboa — ${frontmatter.title}`}>
  <Nav active="docs" />
  <div class="wrap docs-grid">
    <aside aria-label="Documentation navigation">
      <p class="eyebrow">Documentation · <span translate="no">v{docs.versions.cli}</span></p>
      <nav class="doc-tree" aria-label="Guides">
        {groups.map(group => {
          const hasCurrent = group.pages.some(page => `${page.slug}.md` === frontmatter.source);
          return (
          <details class="tree-group" open={hasCurrent} data-group={group.title}>
            <summary>{group.title}</summary>
            <div class="tree-children">
              <div class="tree-links">
                {group.pages.map(page => {
                  const isCurrent = `${page.slug}.md` === frontmatter.source;
                  return <a href={page.url} aria-current={isCurrent ? 'page' : undefined}>{page.title}</a>;
                })}
              </div>
            </div>
          </details>
          );
        })}
      </nav>
    </aside>
    <main class="doc-main" id="main">
      <slot />
    </main>
    {current && current.headings.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <p class="eyebrow">On this page</p>
      <ul>
        {current.headings.map(heading => <li><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}
      </ul>
    </nav>
    )}
  </div>
  <Footer />
<script>
  // Category toggles are independent (no shared `name`), and their open
  // state survives ClientRouter navigations via this session store. Without
  // it the server render (only the current branch open) would reset the
  // sidebar on each page change.
  const groupStore = ((window as any).__docsGroups ??= {});
  const syncGroups = () => {
    document.querySelectorAll('details.tree-group').forEach((d) => {
      if (!(d instanceof HTMLDetailsElement)) return;
      const key = d.getAttribute('data-group') ?? '';
      if (key in groupStore) d.open = groupStore[key];
      if (!d.hasAttribute('data-group-bound')) {
        d.setAttribute('data-group-bound', '');
        d.addEventListener('toggle', () => { groupStore[key] = d.open; });
      }
    });
  };
  // Scrollspy for the "On this page" column: highlight the section in view.
  const setupSpy = () => {
    ((window as any).__tocObserver)?.disconnect();
    const links = Array.from(document.querySelectorAll('[data-toc-link]'));
    if (!links.length) return;
    const byId = new Map(links.map((l) => [(l as HTMLAnchorElement).getAttribute('href')?.slice(1), l]));
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((l) => l.removeAttribute('aria-current'));
        byId.get((entry.target as HTMLElement).id)?.setAttribute('aria-current', 'true');
      }
    }, { rootMargin: '-90px 0px -70% 0px' });
    document.querySelectorAll('.doc-main h2[id]').forEach((h) => observer.observe(h));
    (window as any).__tocObserver = observer;
  };
  syncGroups();
  setupSpy();
  document.addEventListener('astro:page-load', () => { syncGroups(); setupSpy(); });
</script>
</Base>
<style>
  /* Docs override the global no-smooth-scroll rule: article changes and
     in-page anchors scroll smoothly instead of jumping to the top. */
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
  .docs-grid { display: grid; grid-template-columns: 230px minmax(0, 1fr) 200px; align-items: start; gap: 56px; padding-top: 48px; padding-bottom: 96px; }
  aside { position: sticky; top: 88px; max-height: calc(100dvh - 100px); overflow-y: auto; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--muted) 34%, transparent) transparent; }
  aside::-webkit-scrollbar { width: 9px; }
  aside::-webkit-scrollbar-track { background: transparent; }
  aside::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--muted) 34%, transparent); border-radius: 9px; border: 2px solid transparent; background-clip: padding-box; }
  aside:hover::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--accent) 55%, transparent); background-clip: padding-box; }
  aside::-webkit-scrollbar-thumb:hover { background: var(--accent); background-clip: padding-box; }
  .eyebrow { font: 500 11.5px/1.4 var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent); margin-bottom: 14px; }
  .doc-tree { font-size: 15px; }
  .doc-tree summary { display: flex; align-items: baseline; gap: 10px; list-style: none; cursor: pointer; padding: 5px 0; }
  .doc-tree summary::-webkit-details-marker { display: none; }
  .doc-tree summary::before { content: ''; flex: 0 0 5px; width: 5px; height: 5px; border-right: 1px solid var(--muted); border-bottom: 1px solid var(--muted); transform: rotate(-45deg); position: relative; top: -2px; }
  .doc-tree details[open] > summary::before { transform: rotate(45deg); }
  .tree-group { margin-bottom: 4px; }
  .tree-group > summary { font-weight: 600; }
  .tree-children { border-left: 1px solid var(--border); margin: 4px 0 4px 2px; padding-left: 17px; }
  .doc-tree a { display: block; color: var(--muted); padding: 4px 8px; border-radius: 4px; line-height: 1.45; transition: color .15s ease, background .15s ease; }
  .toc { position: sticky; top: 88px; max-height: calc(100dvh - 100px); overflow-y: auto; font-size: 13.5px; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--muted) 34%, transparent) transparent; }
  .toc ul { list-style: none; border-left: 1px solid var(--border); padding-left: 16px; }
  .toc a { display: block; color: var(--muted); padding: 3px 0; line-height: 1.5; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current='true'] { color: var(--accent); font-weight: 500; }
  .toc a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Smooth expand/collapse for categories (same feel as the smooth
     scrolling). Grid-rows trick; instant fallback with reduced motion
     or where ::details-content is unsupported. */
  @media (prefers-reduced-motion: no-preference) {
    .doc-tree summary::before { transition: transform .2s ease; }
    @supports selector(details::details-content) {
      details.tree-group::details-content { content-visibility: visible; }
      .tree-group > .tree-children {
        display: grid;
        grid-template-rows: 1fr;
        opacity: 1;
        transition: grid-template-rows .25s ease, opacity .2s ease, margin-top .25s ease, margin-bottom .25s ease, visibility 0s;
      }
      .tree-group:not([open]) > .tree-children {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        visibility: hidden;
        margin-top: 0;
        margin-bottom: 0;
        transition: grid-template-rows .25s ease, opacity .2s ease, margin-top .25s ease, margin-bottom .25s ease, visibility 0s .25s;
      }
      .tree-group > .tree-children > * { min-height: 0; overflow: hidden; }
    }
  }
  .doc-tree a:hover { color: var(--ink); }
  .doc-tree a[aria-current] { background: var(--surface); color: var(--ink); font-weight: 500; box-shadow: inset 2px 0 0 var(--accent); }
  .doc-tree summary:focus-visible, .doc-tree a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .doc-main { min-width: 0; max-width: 760px; font-size: 16.5px; line-height: 1.75; overflow-wrap: anywhere; }
  .doc-main :global(h1) { font-family: var(--serif); font-size: clamp(38px, 4.6vw, 52px); line-height: 1.08; font-weight: 400; letter-spacing: -.025em; margin-bottom: 28px; text-wrap: balance; }
  .doc-main :global(h2) { font-family: var(--serif); font-weight: 400; margin: 56px 0 16px; padding-top: 28px; border-top: 1px solid var(--border); font-size: 30px; line-height: 1.15; letter-spacing: -.015em; text-wrap: balance; }
  /* The synced pages put a rule under the title; the first section needs no second one. */
  .doc-main :global(h1 + hr), .doc-main :global(hr:has(+ h2)) { display: none; }
  .doc-main :global(h1 + hr + h2), .doc-main :global(h1 + h2) { margin-top: 0; padding-top: 0; border-top: 0; }
  .doc-main :global(h3) { margin: 32px 0 12px; font-size: 18px; font-weight: 600; text-wrap: balance; }
  .doc-main :global(h2, h3, h4) { scroll-margin-top: 100px; }
  .doc-main :global(p, ul, ol, pre, table, blockquote) { margin-bottom: 18px; }
  .doc-main :global(ul, ol) { padding-left: 24px; }
  .doc-main :global(a) { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .doc-main :global(a:hover) { text-decoration-thickness: 2px; }
  .doc-main :global(code) { font-family: var(--mono); font-size: .86em; }
  .doc-main :global(:not(pre) > code) { background: color-mix(in srgb, var(--ink) 7%, transparent); padding: 1.5px 5px; border-radius: 4px; }
  .doc-main :global(pre) { padding: 18px 20px; border-radius: 10px; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.75; font-size: 14.5px; background: var(--term-bg) !important; border: 1px solid rgba(233,220,199,.08); }
  .doc-main :global(table) { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 14.5px; font-variant-numeric: tabular-nums; }
  .doc-main :global(th, td) { border-bottom: 1px solid var(--border); padding: 10px 14px 10px 0; text-align: left; vertical-align: top; }
  .doc-main :global(th) { font: 500 11.5px/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .doc-main :global(blockquote) { border-left: 3px solid var(--accent); padding-left: 18px; color: var(--muted); }
  .doc-main :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 28px 0; }
  @media (max-width: 1100px) {
    .docs-grid { grid-template-columns: 240px minmax(0, 1fr); gap: 48px; }
    .toc { display: none; }
  }
  @media (max-width: 800px) {
    .docs-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 28px; }
    aside { position: static; max-height: none; }
  }
</style>
