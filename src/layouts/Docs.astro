---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import docs from '../data/docs.json';
import type { MarkdownLayoutProps } from 'astro';
type Props = MarkdownLayoutProps<{ title: string; description?: string; source: string }>;
const { frontmatter, rawContent } = Astro.props;

// The page's own description for search results: the first paragraph after
// the title (plus its list when it ends in a colon, or the next paragraph when
// it is short), stripped of Markdown and cut at a word near 155 characters.
function describe(markdown: string): string {
  const isList = (b: string) => /^\s*(?:[-*]|\d+\.)\s/.test(b);
  const blocks = markdown
    .replace(/^[\s\S]*?^# .*$/m, '')
    .replace(/```[\s\S]*?```/g, '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .split(/\n\s*\n/)
    .map((b) => b.trim())
    .filter((b) => b && !/^(#|---|>|\||\{:)/.test(b));
  const first = blocks.findIndex((b) => !isList(b));
  if (first < 0) return `${frontmatter.title} in the jerboa documentation.`;
  let text = blocks[first].replace(/\n/g, ' ');
  const next = blocks[first + 1];
  if (next && text.endsWith(':') && isList(next)) {
    const items = next.split('\n').map((l) => l.replace(/^\s*(?:[-*]|\d+\.)\s+/, '').replace(/[.;]$/, '').trim()).filter(Boolean);
    text = `${text} ${items.join('; ')}.`;
  } else if (next && text.length < 70 && !isList(next)) {
    text = `${text} ${next.replace(/\n/g, ' ')}`;
  }
  text = text
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[`*_]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (text.length <= 160) return text;
  return `${text.slice(0, 155).replace(/\s+\S*$/, '').replace(/[,;:]$/, '')}…`;
}
// A description written in jerboa/docs wins; otherwise derive one.
const description = frontmatter.description ?? describe(rawContent());
const markdown = import.meta.glob('../pages/*.md', { eager: true });
const groups = [
  { title: 'Start', slugs: ['getting-started', 'build-concepts'] },
  { title: 'Guides', slugs: ['macos-guide', 'compose', 'observability', 'troubleshooting'] },
  { title: 'Reference', slugs: ['cli-reference', 'architecture', 'benchmarks', 'release-process'] },
  { title: 'macOS (advanced)', slugs: ['macos', 'macos-firecracker', 'packages-arm64', 'postgres-arm64', 'macos-snapshots', 'macos-shutdown', 'macos-stats', 'macos-distribution'] },
].map(group => ({ ...group, pages: group.slugs.map(slug => {
  const page = docs.pages.find(page => page.slug === slug)!;
  const module = markdown[`../pages/${slug}.md`] as { getHeadings: () => { depth: number; slug: string; text: string }[] };
  return { ...page, headings: module.getHeadings().filter(heading => heading.depth === 2) };
}) }));
const current = groups.flatMap(group => group.pages).find(page => `${page.slug}.md` === frontmatter.source);
const group = groups.find(g => g.pages.some(page => `${page.slug}.md` === frontmatter.source));
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
// The pages in sidebar order, for the previous and next links under the article.
const ordered = groups.flatMap(g => g.pages);
const at = current ? ordered.indexOf(current) : -1;
const previous = at > 0 ? ordered[at - 1] : undefined;
const following = at >= 0 && at < ordered.length - 1 ? ordered[at + 1] : undefined;

// schema.org: the page is a technical article about jerboa, inside a
// Documentation > section > page trail.
const structuredData = [
  {
    '@type': 'TechArticle',
    '@id': `${pageUrl}#article`,
    headline: frontmatter.title,
    description,
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
    about: { '@type': 'SoftwareApplication', '@id': 'https://jerboa.dev/#software', name: 'jerboa' },
    version: docs.versions.cli,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Documentation', item: new URL('/getting-started/', Astro.site).href },
      ...(group ? [{ '@type': 'ListItem', position: 2, name: group.title }] : []),
      { '@type': 'ListItem', position: group ? 3 : 2, name: frontmatter.title, item: pageUrl },
    ],
  },
];
---
<Base title={`${frontmatter.title} — jerboa docs`} description={description} ogType="article" structuredData={structuredData}>
  <Nav active="docs" />
  <div class="wrap docs-grid">
    <aside aria-label="Documentation navigation">
      <p class="eyebrow">Documentation · <span translate="no">v{docs.versions.cli}</span></p>
      <nav class="doc-tree" aria-label="Guides">
        {groups.map(group => {
          const hasCurrent = group.pages.some(page => `${page.slug}.md` === frontmatter.source);
          return (
          <details class="tree-group" open={hasCurrent} data-group={group.title}>
            <summary>{group.title}</summary>
            <div class="tree-children">
              <div class="tree-links">
                {group.pages.map(page => {
                  const isCurrent = `${page.slug}.md` === frontmatter.source;
                  return <a href={page.url} aria-current={isCurrent ? 'page' : undefined}>{page.title}</a>;
                })}
              </div>
            </div>
          </details>
          );
        })}
      </nav>
    </aside>
    <main class="doc-main" id="main">
      <p class="eyebrow crumb">{group ? group.title : 'Documentation'}</p>
      <article class="prose">
        <slot />
      </article>
      {(previous || following) && (
      <nav class="pager" aria-label="More pages">
        {previous ? <a class="pager-link" href={previous.url}><span class="eyebrow">Previous</span><span class="pager-title">{previous.title}</span></a> : <span></span>}
        {following && <a class="pager-link is-next" href={following.url}><span class="eyebrow">Next</span><span class="pager-title">{following.title}</span></a>}
      </nav>
      )}
    </main>
    {current && current.headings.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <p class="eyebrow">On this page</p>
      <ul>
        {current.headings.map(heading => <li><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}
      </ul>
    </nav>
    )}
  </div>
  <Footer />
<script>
  // Category toggles are independent (no shared `name`), and their open
  // state survives ClientRouter navigations via this session store. Without
  // it the server render (only the current branch open) would reset the
  // sidebar on each page change.
  const groupStore = ((window as any).__docsGroups ??= {});
  const syncGroups = () => {
    document.querySelectorAll('details.tree-group').forEach((d) => {
      if (!(d instanceof HTMLDetailsElement)) return;
      const key = d.getAttribute('data-group') ?? '';
      if (key in groupStore) d.open = groupStore[key];
      if (!d.hasAttribute('data-group-bound')) {
        d.setAttribute('data-group-bound', '');
        d.addEventListener('toggle', () => { groupStore[key] = d.open; });
      }
    });
  };
  // Scrollspy for the "On this page" column: highlight the section in view.
  const setupSpy = () => {
    ((window as any).__tocObserver)?.disconnect();
    const links = Array.from(document.querySelectorAll('[data-toc-link]'));
    if (!links.length) return;
    const byId = new Map(links.map((l) => [(l as HTMLAnchorElement).getAttribute('href')?.slice(1), l]));
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((l) => l.removeAttribute('aria-current'));
        byId.get((entry.target as HTMLElement).id)?.setAttribute('aria-current', 'true');
      }
    }, { rootMargin: '-12% 0% -70% 0%' });
    document.querySelectorAll('.doc-main h2[id]').forEach((h) => observer.observe(h));
    (window as any).__tocObserver = observer;
  };
  // A copy button on every code block. The label reports the outcome.
  const setupCopy = () => {
    document.querySelectorAll<HTMLElement>('.prose pre:not([data-copy-bound])').forEach((pre) => {
      pre.setAttribute('data-copy-bound', '');
      const frame = document.createElement('div');
      frame.className = 'code-frame';
      pre.replaceWith(frame);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = 'Copy';
      btn.setAttribute('aria-label', 'Copy code');
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText.trimEnd());
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Select to copy';
        }
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      });
      frame.append(pre, btn);
    });
  };
  syncGroups();
  setupSpy();
  setupCopy();
  document.addEventListener('astro:page-load', () => { syncGroups(); setupSpy(); setupCopy(); });
</script>
</Base>
<style>
  /* Docs override the global no-smooth-scroll rule: in-page anchors scroll
     smoothly instead of jumping. */
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  /* Sidebar, article and on-page index. The sidebar is as wide as the rail on
     jerboa.dev, so the two sites share their left edge. */
  .docs-grid { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr) var(--rail); gap: var(--space-64); align-items: start; padding-top: var(--space-48); }
  aside, .toc { position: sticky; top: calc(var(--nav-height) + var(--space-32)); max-height: calc(100dvh - var(--nav-height) - var(--space-64)); overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
  .eyebrow { font: var(--weight-medium) var(--text-12) / var(--leading-body) var(--font-mono); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--text-muted); }
  aside > .eyebrow, .toc > .eyebrow { margin-bottom: var(--space-12); }

  /* ===== sidebar tree ===== */
  .doc-tree { font-size: var(--text-14); }
  .tree-group + .tree-group { margin-top: var(--space-8); }
  .doc-tree summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); min-height: var(--control-md); padding-right: var(--space-8); border-radius: var(--radius-sm); list-style: none; cursor: pointer; font-weight: var(--weight-medium); color: var(--text); }
  .doc-tree summary::-webkit-details-marker { display: none; }
  .doc-tree summary::after { content: ''; width: var(--space-6); height: var(--space-6); border-right: var(--hairline) solid var(--text-muted); border-bottom: var(--hairline) solid var(--text-muted); transform: rotate(-45deg); transition: transform var(--duration-layout) var(--ease-layout); }
  .doc-tree details[open] > summary::after { transform: rotate(45deg); }
  .tree-children { border-left: var(--hairline) solid var(--border); }
  .doc-tree a { display: flex; align-items: center; min-height: var(--control-md); margin-left: calc(-1 * var(--hairline)); padding: var(--space-4) var(--space-16); border-left: var(--hairline) solid transparent; color: var(--text-muted); line-height: var(--leading-heading); transition: color var(--duration-hover) var(--ease-hover), border-color var(--duration-hover) var(--ease-hover); }
  .doc-tree a:hover { color: var(--text); border-left-color: var(--border-strong); }
  .doc-tree a[aria-current] { color: var(--accent); border-left-color: var(--accent); }

  /* ===== on this page ===== */
  .toc { font-size: var(--text-13); }
  .toc ul { list-style: none; border-left: var(--hairline) solid var(--border); }
  .toc a { display: flex; align-items: center; min-height: var(--control-sm); margin-left: calc(-1 * var(--hairline)); padding: var(--space-4) var(--space-16); border-left: var(--hairline) solid transparent; color: var(--text-muted); line-height: var(--leading-heading); transition: color var(--duration-hover) var(--ease-hover), border-color var(--duration-hover) var(--ease-hover); }
  .toc a:hover { color: var(--text); }
  .toc a[aria-current='true'] { color: var(--text); border-left-color: var(--accent); }

  /* ===== article ===== */
  .doc-main { min-width: 0; }
  .crumb { color: var(--accent); margin-bottom: var(--space-12); }
  .prose { max-width: var(--reading); font-size: var(--text-16); line-height: var(--leading-reading); overflow-wrap: anywhere; }
  .prose :global(h1), .prose :global(h2), .prose :global(h3) { color: var(--text); }
  .prose :global(h1) { font-size: var(--text-40); line-height: var(--leading-display); letter-spacing: var(--tracking-display); margin-bottom: var(--space-32); }
  .prose :global(h2) { font-size: var(--text-24); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); margin: var(--space-48) 0 var(--space-16); padding-top: var(--space-48); border-top: var(--hairline) solid var(--border); }
  .prose :global(h3) { font-size: var(--text-18); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); margin: var(--space-32) 0 var(--space-12); }
  .prose :global(h4) { font-size: var(--text-16); font-weight: var(--weight-display); margin: var(--space-24) 0 var(--space-8); }
  /* The synced pages put a rule under the title and between sections; the
     section border replaces them. */
  .prose :global(h1 + hr), .prose :global(hr:has(+ h2)) { display: none; }
  .prose :global(h1 + hr + h2), .prose :global(h1 + h2) { margin-top: 0; padding-top: 0; border-top: 0; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(table), .prose :global(blockquote), .prose :global(.code-frame), .prose :global(pre) { margin-bottom: var(--space-20); }
  .prose :global(p), .prose :global(li) { color: var(--text-body); }
  .prose :global(ul), .prose :global(ol) { padding-left: var(--space-24); }
  .prose :global(li + li) { margin-top: var(--space-6); }
  .prose :global(li > ul), .prose :global(li > ol) { margin: var(--space-6) 0 0; }
  .prose :global(li::marker) { color: var(--graphic-muted); }
  .prose :global(strong) { color: var(--text); font-weight: var(--weight-display); }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-decoration-color: var(--accent-line); text-underline-offset: 0.25em; transition: text-decoration-color var(--duration-hover) var(--ease-hover); }
  .prose :global(a:hover) { text-decoration-color: var(--accent); }
  .prose :global(code) { font-family: var(--font-mono); font-size: var(--text-14); }
  .prose :global(:not(pre) > code) { padding: var(--space-2) var(--space-6); border: var(--hairline) solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text); font-size: var(--text-13); box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  /* Shiki's css-variables theme, mapped onto the stone tokens: monochrome,
     with emphasis by lightness only. */
  :global(:root) {
    --astro-code-foreground: var(--stone-200);
    --astro-code-background: var(--surface);
    --astro-code-token-keyword: var(--text);
    --astro-code-token-function: var(--accent);   /* commands such as jerboa, sudo, curl */
    --astro-code-token-constant: var(--stone-200);
    --astro-code-token-parameter: var(--stone-200);
    --astro-code-token-string: var(--stone-400);
    --astro-code-token-string-expression: var(--stone-400);
    --astro-code-token-comment: var(--graphic-muted);
    --astro-code-token-punctuation: var(--text-muted);
    --astro-code-token-link: var(--text);
  }
  /* Shiki writes its own background inline; the surface token wins. */
  .prose :global(pre) { padding: var(--space-16) var(--space-20); border: var(--hairline) solid var(--border); border-radius: var(--radius-lg); background: var(--surface) !important; white-space: pre-wrap; font-size: var(--text-14); line-height: var(--leading-reading); }
  /* The copy button sits in the block's corner and shows on hover or focus. */
  .prose :global(.code-frame) { position: relative; }
  .prose :global(.code-frame pre) { margin-bottom: 0; }
  .prose :global(.code-frame .code-copy) { position: absolute; top: var(--space-6); right: var(--space-6); border: var(--hairline) solid var(--border); background: var(--surface-raised); opacity: 0; transition: opacity var(--duration-hover) var(--ease-hover), color var(--duration-hover) var(--ease-hover); }
  .prose :global(.code-frame:hover .code-copy), .prose :global(.code-frame .code-copy:focus-visible) { opacity: 1; }
  @media (hover: none) { .prose :global(.code-frame .code-copy) { opacity: 1; } }
  .prose :global(table) { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; font-size: var(--text-14); line-height: var(--leading-body); font-variant-numeric: tabular-nums; overflow-wrap: normal; }
  .prose :global(th), .prose :global(td) { padding: var(--space-12) var(--space-16) var(--space-12) 0; border-bottom: var(--hairline) solid var(--border); text-align: left; vertical-align: top; }
  .prose :global(td) { color: var(--text-body); }
  .prose :global(th) { font: var(--weight-medium) var(--text-12) / var(--leading-body) var(--font-mono); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--text-muted); white-space: nowrap; }
  .prose :global(blockquote) { padding: var(--space-12) var(--space-16); border-left: var(--focus-width) solid var(--accent); border-radius: 0 var(--radius-md) var(--radius-md) 0; background: var(--accent-soft); }
  .prose :global(blockquote > :last-child) { margin-bottom: 0; }
  .prose :global(hr) { border: 0; border-top: var(--hairline) solid var(--border); margin: var(--space-32) 0; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-md); }

  /* ===== previous and next ===== */
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-16); max-width: var(--reading); margin-top: var(--space-64); padding-top: var(--space-32); border-top: var(--hairline) solid var(--border); }
  .pager-link { display: grid; gap: var(--space-4); padding: var(--space-16) var(--space-20); border: var(--hairline) solid var(--border); border-radius: var(--radius-lg); transition: border-color var(--duration-hover) var(--ease-hover), background-color var(--duration-hover) var(--ease-hover); }
  .pager-link:hover { border-color: var(--border-strong); background: var(--surface); }
  .pager-link.is-next { text-align: right; }
  .pager-title { font-weight: var(--weight-medium); color: var(--text); }
  .pager-link:hover .pager-title { color: var(--accent); }

  @media (max-width: 76em) {
    .docs-grid { grid-template-columns: var(--rail) minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 54em) {
    .docs-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-24); padding-top: var(--space-24); }
    aside { position: static; max-height: none; padding-bottom: var(--space-16); border-bottom: var(--hairline) solid var(--border); }
    .doc-tree summary, .doc-tree a { min-height: var(--control-lg); }
    .prose :global(h1) { font-size: var(--text-32); }
    .pager { grid-template-columns: minmax(0, 1fr); }
    .pager-link.is-next { text-align: left; }
  }
</style>
